{
  "name": "@errtap/next",
  "version": "0.1.0",
  "description": "ErrTap SDK for Next.js (App Router client + server)",
  "type": "module",
  "main": "client.js",
  "types": "client.d.ts",
  "exports": {
    ".": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "default": "./server.js"
    }
  },
  "files": ["client.js", "client.d.ts", "server.js", "server.d.ts"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "dependencies": {
    "@errtap/browser": "^0.1.0",
    "@errtap/node": "^0.1.0"
  },
  "peerDependencies": {
    "next": ">=13.0.0"
  }
}
