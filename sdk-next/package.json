{
  "name": "@errtap/next",
  "version": "0.5.1",
  "description": "ErrTap SDK for Next.js (App Router client + server)",
  "type": "module",
  "main": "client.js",
  "types": "client.d.ts",
  "bin": {
    "errtap-upload-sourcemaps": "upload-sourcemaps.mjs"
  },
  "exports": {
    ".": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "default": "./server.js"
    }
  },
  "files": [
    "client.js",
    "client.d.ts",
    "server.js",
    "server.d.ts",
    "upload-sourcemaps.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@errtap/browser": "^0.4.0",
    "@errtap/node": "^0.4.0"
  },
  "peerDependencies": {
    "next": ">=13.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErrTap/errtap-sdks.git",
    "directory": "sdk-next"
  },
  "homepage": "https://docs.errtap.com",
  "bugs": {
    "url": "https://github.com/ErrTap/errtap-sdks/issues"
  },
  "keywords": [
    "error-tracking",
    "monitoring",
    "observability",
    "errtap",
    "nextjs"
  ]
}
