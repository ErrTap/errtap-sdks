{
  "name": "errtap/laravel",
  "description": "ErrTap error tracking for Laravel — reports unhandled exceptions to your ErrTap project.",
  "version": "0.1.1",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "ErrTap\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ErrTap\\ErrTapServiceProvider"
      ]
    }
  }
}
